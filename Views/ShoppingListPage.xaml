<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FrigoMalin.ViewModels"
             xmlns:m="clr-namespace:FrigoMalin.Models"
             x:Class="FrigoMalin.Views.ShoppingListPage"
             Title="🛒 Liste de Marché"
             BackgroundColor="#F8F9FA">

    <Grid>
        <!-- CONTENU PRINCIPAL DE LA CHECKLIST -->
        <ScrollView Padding="16">
            <VerticalStackLayout Spacing="16">
                
                <!-- CARTE AJOUT D'UN ARTICLE À LA LISTE DE COURSES -->
                <Frame BackgroundColor="White" CornerRadius="12" Padding="14" HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="📝 Préparer mes courses" FontAttributes="Bold" FontSize="16" TextColor="#1B5E20" />
                        
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Grid.Column="0" 
                                   Placeholder="Article à acheter (ex: Œufs, Bananes...)" 
                                   Text="{Binding NewItemName}" 
                                   FontSize="14" />
                            <Button Grid.Column="1" 
                                    Text="➕ Ajouter" 
                                    BackgroundColor="#2E7D32" 
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="8"
                                    Command="{Binding AddItemCommand}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                            <Picker Grid.Column="0" 
                                    Title="Catégorie" 
                                    ItemsSource="{Binding Categories}" 
                                    SelectedItem="{Binding NewItemCategory}" 
                                    FontSize="12" />
                            <Entry Grid.Column="1" 
                                   Placeholder="Qté (ex: 2)" 
                                   Keyboard="Numeric" 
                                   Text="{Binding NewItemQuantity}" 
                                   FontSize="12" />
                            <Entry Grid.Column="2" 
                                   Placeholder="Prix (FCFA)" 
                                   Keyboard="Numeric" 
                                   Text="{Binding NewItemPrice}" 
                                   FontSize="12" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- SECTION EXPLICATIVE DE LA CHECKLIST -->
                <Frame BackgroundColor="#E3F2FD" BorderColor="#90CAF9" CornerRadius="10" Padding="12">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="💡" FontSize="18" VerticalOptions="Center" />
                        <Label Text="Cochez un article acheté : l'app pré-remplit les cases et vous demande la date de péremption pour le transférer au frigo !"
                               FontSize="12" TextColor="#0D47A1" LineBreakMode="WordWrap" />
                    </HorizontalStackLayout>
                </Frame>

                <!-- LISTE DE MARCHÉ SOUS FORME DE CHECKLIST -->
                <Label Text="Checklist du marché :" FontAttributes="Bold" FontSize="16" TextColor="#333" Margin="0,4,0,0" />

                <CollectionView ItemsSource="{Binding ShoppingItems}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center" Margin="0,30" Spacing="6">
                            <Label Text="🛒" FontSize="36" HorizontalOptions="Center" />
                            <Label Text="Votre liste de courses est vide." TextColor="#757575" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="m:ShoppingItem">
                            <Frame Margin="0,0,0,8"
                                   Padding="12"
                                   CornerRadius="10"
                                   BackgroundColor="{Binding IsPurchased, Converter={StaticResource InverseBoolConv}, ConverterParameter='#FFFFFF'}"
                                   BorderColor="#E0E0E0">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                    
                                    <!-- CASE À COCHER INTERACTIVE -->
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsPurchased}"
                                              Color="#2E7D32"
                                              CheckedChanged="OnItemCheckedChanged" />

                                    <!-- DÉTAILS DE L'ARTICLE -->
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Name}" 
                                               FontAttributes="Bold" 
                                               FontSize="15" 
                                               TextColor="{Binding IsPurchased, Converter={StaticResource InverseBoolConv}, ConverterParameter='#212121'}" />
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding CategoryDisplay}" FontSize="11" TextColor="#757575" />
                                            <Label Text="{Binding Quantity, StringFormat='Qté: {0}'}" FontSize="11" TextColor="#616161" />
                                            <Label Text="{Binding EstimatedPrice, StringFormat='{0:N0} FCFA'}" FontSize="11" TextColor="#2E7D32" FontAttributes="Bold" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <!-- BOUTON SUPPRIMER -->
                                    <Button Grid.Column="2" 
                                            Text="🗑️" 
                                            BackgroundColor="Transparent" 
                                            TextColor="#D32F2F"
                                            FontSize="14"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ShoppingListViewModel}}, Path=DeleteItemCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- MODALE DE TRANSFERT AUTOMATIQUE MARCHÉ -> FRIGO AVEC DATE MANUELLE -->
        <Grid IsVisible="{Binding IsTransferModalVisible}"
              BackgroundColor="#80000000"
              Padding="24">
            
            <Frame VerticalOptions="Center"
                   BackgroundColor="White"
                   CornerRadius="16"
                   Padding="20"
                   HasShadow="True">
                
                <VerticalStackLayout Spacing="14">
                    
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="❄️" FontSize="24" VerticalOptions="Center" />
                        <VerticalStackLayout>
                            <Label Text="Transférer vers le Frigo" FontAttributes="Bold" FontSize="17" TextColor="#2E7D32" />
                            <Label Text="Champs pré-remplis automatiquement :" FontSize="12" TextColor="#757575" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <!-- NOM (AUTO-REMPLI) -->
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Nom de l'aliment :" FontSize="12" TextColor="#555" />
                        <Entry Text="{Binding TransferName}" 
                               BackgroundColor="#F1F8E9" 
                               FontAttributes="Bold" 
                               TextColor="#1B5E20" />
                    </VerticalStackLayout>

                    <!-- CATÉGORIE & QUANTITÉ (AUTO-REMPLIS) -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Catégorie :" FontSize="12" TextColor="#555" />
                            <Picker ItemsSource="{Binding Categories}" 
                                    SelectedItem="{Binding TransferCategory}" 
                                    BackgroundColor="#F1F8E9" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Quantité :" FontSize="12" TextColor="#555" />
                            <Entry Text="{Binding TransferQuantity}" 
                                   Keyboard="Numeric" 
                                   BackgroundColor="#F1F8E9" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- DATE D'ACHAT (AUTO-REMPLIE = AUJOURD'HUI) -->
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Date d'achat (Date du jour) :" FontSize="12" TextColor="#555" />
                        <DatePicker Date="{Binding TransferPurchaseDate}" 
                                    Format="dd/MM/yyyy" 
                                    IsEnabled="False" 
                                    BackgroundColor="#F1F8E9" />
                    </VerticalStackLayout>

                    <!-- DATE DE PÉREMPTION (SAISIE MANUELLE PAR L'UTILISATEUR) -->
                    <Frame BackgroundColor="#FFF3E0" BorderColor="#FFB74D" Padding="10" CornerRadius="8">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="🗓️ Date de péremption (Saisie Manuelle) *" 
                                   FontAttributes="Bold" 
                                   FontSize="13" 
                                   TextColor="#E65100" />
                            <Label Text="Indiquez la date limite réelle vue sur l'emballage ou le produit :" 
                                   FontSize="11" 
                                   TextColor="#757575" />
                            <DatePicker Date="{Binding TransferManualExpiryDate}" 
                                        Format="dd/MM/yyyy" 
                                        TextColor="#D32F2F" 
                                        FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- BOUTONS ACTIONS -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                        <Button Grid.Column="0" 
                                Text="Annuler" 
                                BackgroundColor="#EEEEEE" 
                                TextColor="#424242" 
                                CornerRadius="8"
                                Command="{Binding CancelTransferCommand}" />
                        
                        <Button Grid.Column="1" 
                                Text="✅ Valider l'ajout" 
                                BackgroundColor="#2E7D32" 
                                TextColor="White" 
                                FontAttributes="Bold" 
                                CornerRadius="8"
                                Command="{Binding ConfirmTransferCommand}" />
                    </Grid>

                </VerticalStackLayout>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>
