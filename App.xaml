<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:FrigoMalin.Converters"
             xmlns:local="clr-namespace:FrigoMalin"
             x:Class="FrigoMalin.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- CONVERTISSEURS GLOBAUX -->
            <conv:InverseBoolConverter x:Key="InverseBoolConv" />
            <conv:UrgencyToColorConverter x:Key="UrgencyColorConv" />
            <conv:UrgencyToBgColorConverter x:Key="UrgencyBgConv" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
