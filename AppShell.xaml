<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FrigoMalin.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:FrigoMalin.Views"
    Shell.FlyoutBehavior="Disabled">

    <!-- PAGE DE CONNEXION / AUTHENTIFICATION (POINT D'ENTRÉE) -->
    <ShellContent
        Title="Connexion"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />

    <!-- PAGE D'INSCRIPTION -->
    <ShellContent
        Title="Inscription"
        ContentTemplate="{DataTemplate views:RegisterPage}"
        Route="RegisterPage" />

    <!-- NAVIGATION PRINCIPALE PAR ONGLETS -->
    <TabBar Route="MainTabs">
        <!-- ONGLET 1 : MON FRIGO -->
        <Tab Title="Mon Frigo" Icon="icon_fridge.png">
            <ShellContent
                Title="Mon Frigo"
                ContentTemplate="{DataTemplate views:FridgePage}"
                Route="FridgePage" />
        </Tab>

        <!-- ONGLET 2 : LISTE DE MARCHÉ -->
        <Tab Title="Marché" Icon="icon_market.png">
            <ShellContent
                Title="Marché"
                ContentTemplate="{DataTemplate views:ShoppingListPage}"
                Route="ShoppingListPage" />
        </Tab>

        <!-- ONGLET 3 : MENUS & RECETTES -->
        <Tab Title="Recettes" Icon="icon_recipes.png">
            <ShellContent
                Title="Recettes"
                ContentTemplate="{DataTemplate views:RecipesPage}"
                Route="RecipesPage" />
        </Tab>

        <!-- ONGLET 4 : BILAN ANTI-GASPI -->
        <Tab Title="Bilan" Icon="icon_stats.png">
            <ShellContent
                Title="Bilan"
                ContentTemplate="{DataTemplate views:WasteStatsPage}"
                Route="WasteStatsPage" />
        </Tab>

        <!-- ONGLET 5 : PROFIL & PARAMÈTRES -->
        <Tab Title="Profil" Icon="icon_user.png">
            <ShellContent
                Title="Profil"
                ContentTemplate="{DataTemplate views:ProfileSettingsPage}"
                Route="ProfileSettingsPage" />
        </Tab>
    </TabBar>

</Shell>
